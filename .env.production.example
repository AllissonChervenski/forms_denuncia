# ==============================================================================
# Variáveis de Ambiente para Produção - forms_denuncia
# IMPORTANTE: Nunca versione arquivos .env preenchidos com valores reais.
# Copie este modelo para .env no servidor de produção e defina valores seguros.
# ==============================================================================

# Django Core Settings
DEBUG=False
SECRET_KEY=substitua_por_uma_chave_secreta_longa_e_aleatoria_min_50_chars
ALLOWED_HOSTS=denuncias.exemplo.com.br,www.denuncias.exemplo.com.br,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://denuncias.exemplo.com.br,https://www.denuncias.exemplo.com.br

# PostgreSQL Database Settings
POSTGRES_DB=forms_denuncia_prod
POSTGRES_USER=forms_user
POSTGRES_PASSWORD=defina_uma_senha_muito_forte_aqui
POSTGRES_HOST=db
POSTGRES_PORT=5432
CONN_MAX_AGE=60

# Redis & Celery Settings
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Rate Limiting
RATE_LIMIT_ENABLED=True

# Security Settings (Ativar True se estiver rodando com HTTPS/Certificado SSL válido)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000

# Docker Registry Image (Utilizado pelo docker-compose.prod.yml)
IMAGE_NAME=ghcr.io/seu-usuario-github/forms_denuncia
IMAGE_TAG=latest
