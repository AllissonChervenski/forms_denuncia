# Git e controle de versão
.git/
.github/
.gitignore
.gitattributes

# Arquivos de ambiente e segredos locais (CRÍTICO: nunca incluir no container)
.env
.env.*
!.env.production.example

# Ambientes virtuais locais
.venv/
venv/
ENV/
env/

# Cache e compilação Python
